APP_ENV=development
APP_BASE_PATH=/weixin-bot-notification-platform
APP_PUBLIC_BASE_URL=http://127.0.0.1:8091
APP_DATABASE_URL=sqlite:///./data/notification-center.db
APP_UPLOAD_DIR=./uploads
APP_DOWNLOAD_TTL_SECONDS=900
APP_BINDING_TTL_SECONDS=600
APP_NATIVE_VIDEO_MAX_BYTES=20971520
APP_UPLOAD_MAX_BYTES=268435456
APP_DELIVERY_MODE=mock
# Generate unique secrets for production; never commit real values.
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_IDENTIFIER_ENCRYPTION_KEY=replace-with-fernet-key
APP_IDENTIFIER_HMAC_KEY=replace-with-at-least-32-random-characters
APP_BOT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
APP_SERVICE_API_TOKEN=replace-with-at-least-32-random-characters
# Optional tenant-scoped business tokens. Keep real values only in the root-owned env file.
# These tokens can query employees, upload assets, create notifications, and read status only.
APP_COMPANY_SERVICE_TOKENS_JSON={}
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# Per-employee Bot credentials are created by official QR login and encrypted in the DB.
# Never add or reuse an existing management Bot credential here.
# Optional: defaults to ~/.hermes/hermes-agent. Set only for a nonstandard install.
HERMES_AGENT_ROOT=
EMPLOYEE_BOT_HERMES_HOME=./data/hermes-employee-bot
APP_INTERNAL_URL=http://127.0.0.1:8091
